{
  "arxiv_id": "2209.00588",
  "title": "Transformers are Sample-Efficient World Models",
  "methods": [
    {
      "method_name": "IRIS",
      "is_own_method": true,
      "one_paragraph_description": "Data-efficient agent that learns entirely in the imagination of a world model composed of a discrete autoencoder (VQ-VAE style, 16 tokens per 64x64 frame, vocabulary 512) and an autoregressive GPT-like Transformer that predicts next frame tokens, reward and episode end. The actor-critic (CNN + LSTM, DreamerV2 objectives: lambda-returns, REINFORCE with entropy) is trained on imagined trajectories of horizon H=20 rolled out from real frames; at runtime the policy observes reconstructed frames and samples actions.",
      "conventional_lineage_hint": "'learning in the imagination of a world model'; 'a new state of the art for methods without lookahead search' (Abstract) — model-based RL / world models / Transformers for sequence modeling",
