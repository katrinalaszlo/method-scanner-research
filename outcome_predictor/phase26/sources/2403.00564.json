{
 "arxiv_id": "2403.00564",
 "title": "EfficientZero V2: Mastering Discrete and Continuous Control with Limited Data",
 "methods": [
  {
   "method_name": "EZ-V2",
   "is_own_method": true,
   "one_paragraph_description": "MuZero/EfficientZero-style model-based agent: learns a latent dynamics model with representation, dynamics, reward, value and policy networks plus a self-supervised consistency loss, and plans actions with a sampling-based Gumbel search (S-Gumbel Search) over the learned model, using only 16 simulations and 8 sampled actions on Atari 100k. Value targets use a 'mixed value target' combining search-based value estimation (SVE) for stale data with multi-step TD targets for fresh data. Trained with SGD, batch 256, UTD 1.",
   "conventional_lineage_hint": "model-based RL with tree search / MuZero lineage: 'Our method surpasses the previous state-of-the-art, EfficientZero'; 'the planning with tree search ... and the mixed value target'; compared against 'lookahead search' methods",
