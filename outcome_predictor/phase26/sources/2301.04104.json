  "arxiv_id": "2301.04104",
  "title": "Mastering Diverse Domains through World Models",
  "methods": [
    {
      "method_name": "DreamerV3 (printed as 'Dreamer' in Table 9)",
      "is_own_method": true,
      "one_paragraph_description": "General world-model algorithm with a single configuration across domains. Learns an RSSM world model (CNN encoder, block-GRU sequence model, discrete latents with unimix, symlog observation prediction, twohot symexp reward/critic heads, KL balancing with free bits) from replayed experience, and trains an actor-critic purely on imagined latent trajectories of horizon 15 using lambda-returns, percentile-based return normalization and entropy regularization. Runtime action selection is the actor applied to the model's latent state.",
      "conventional_lineage_hint": "'Dreamer learns a model of the environment and improves its behavior by imagining future scenarios' (Abstract); 'We present the third generation of the Dreamer line of work' — model-based RL / world models",
