{
  "arxiv_id": "2106.04152",
  "title": "PlayVirtual: Augmenting Cycle-Consistent Virtual Trajectories for Reinforcement Learning",
  "methods": [
    {
      "method_name": "PlayVirtual",
      "is_own_method": true,
      "one_paragraph_description": "PlayVirtual builds on SPR (Rainbow-based for Atari). In addition to SPR's forward latent prediction loss, it adds a backward dynamics model (BDM): from current latent state z_t it samples M sets of K random actions, rolls forward with the dynamics model, rolls backward with the BDM, and enforces a cycle-consistency loss d_M(z'_t, z_t) on the returned state (computed in the SPR 'projection' space). This generates abundant virtual trajectories with no ground-truth state supervision to regularize encoder representation learning. Total loss = RL + lambda_pred * L_pred + lambda_cyc * L_cyc, with lambda_cyc warmed up (Gaussian ramp-up to 1 at 50K). Auxiliary models discarded at test time.",
      "conventional_lineage_hint": "self-supervised representation learning / auxiliary tasks for data-efficient deep RL from pixels ('augments cycle-consistent virtual trajectories to enhance the data efficiency for RL feature representation learning'); built on SPR / Rainbow",
