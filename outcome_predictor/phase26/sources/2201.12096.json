{
  "arxiv_id": "2201.12096",
  "title": "Mask-based Latent Reconstruction for Reinforcement Learning",
  "methods": [
    {
      "method_name": "MLR",
      "is_own_method": true,
      "one_paragraph_description": "MLR (Mask-based Latent Reconstruction) adds a self-supervised auxiliary objective to a Rainbow agent (with random crop + intensity augmentation): a sequence of K=16 observations is masked with random space-time cubes (mask ratio 50%, cube 8x12x12 on Atari), the online encoder encodes the masked observations, a 2-layer Transformer 'predictive latent decoder' with action tokens predicts the complete latent states, and the predictions are matched via cosine similarity (through projection/prediction heads) to momentum-encoder targets computed from the unmasked observations (stop-gradient). Total loss = L_rl + lambda * L_mlr (lambda=1, 5 for Pong and Up N Down). The decoder is discarded at test time.",
      "conventional_lineage_hint": "self-supervised representation learning for sample-efficient RL from pixels ('mask-based reconstruction to promote state representation learning in RL'); auxiliary task on top of Rainbow (discrete) / SAC (continuous)",
