{
 "arxiv_id": "2305.19452",
 "title": "Bigger, Better, Faster: Human-level Atari with human-level efficiency",
 "methods": [
  {
   "method_name": "BBF",
   "is_own_method": true,
   "one_paragraph_description": "Model-free value-based agent built on SR-SPR (Rainbow-style Q-learning with SPR self-supervised objective, periodic shrink-and-perturb network resets and high replay ratio). BBF scales the encoder to a 4x-wide Impala-CNN ResNet, uses harder resets (50% perturbation toward random init), an update horizon (n-step) annealed exponentially from 10 to 3 and discount annealed from 0.97 to 0.997 after each reset, weight decay 0.1 via AdamW, an EMA target network, and removes NoisyNets. Trained at replay ratio 8 (RR=2 also reported for ablations).",
   "conventional_lineage_hint": "model-free RL / value-based RL: 'we introduce BBF, a modelfree RL agent that achieves super-human performance'; 'We introduce a value-based RL agent'",
   "global_conditions": {
    "replay_ratio": {
     "value": "8",
     "quote": "use of periodic network resets, SR-SPR is able to scale up its replay ratio (RR) to values as high as 16, yielding better sample efficiency. For BBF, we use RR=8 in order to balance the increased computation arising from our large network.",
     "location": "Section 4 (Base agent), txt l.541-544"
    },
    "encoder": {
     "value": "Impala-CNN 15-layer ResNet, width scaled 4x",
     "quote": "Impala-CNN (Espeholt et al., 2018) network, a 15-layer ResNet ... Additionally, BBF scales the width of each layer in Impala-CNN by 4×.",
     "location": "Section 4 (Larger network), txt l.524-529"
    },
    "width_scale": {
     "value": "4",
     "quote": "Given that ResNet BBF performs comparably at 4× and 8×, we chose 4× to reduce the computational burden.",
     "location": "Section 4, txt l.556-557"
    },
    "n_step_schedule": {
     "value": "10 -> 3, exponential over first 10K gradient steps after each reset",
     "quote": "that decreases exponentially from 10 to 3 over the first 10K gradient steps following each network reset.",
     "location": "Section 4 (Receding update horizon), txt l.567-569"
    },
    "reset_interval_gradient_steps": {
     "value": "40k",
     "quote": "follow the schedule of D’Oro et al. (2023) and reset every ... 40k gradient steps, the annealing phase is always 25% of training, regardless of the replay ratio.",
     "location": "Section 4, txt l.570 and l.653-654"
    },
    "discount_schedule": {
     "value": "0.97 -> 0.997",
     "quote": "We choose γ1 = 0.97, slightly lower than the typical discount used for Atari, and γ2 = 0.997 as it is used by MuZero",
     "location": "Section 4 (Increasing discount factor), txt l.671-673"
    },
    "reset_perturbation": {
     "value": "50% toward random target (conv layers)",
     "quote": "move them 50% towards the random target, resulting in a stronger perturbation and improving results (see Figure 5).",
     "location": "Section 4 (Harder resets), txt l.519-520"
    },
    "optimizer": {
     "value": "AdamW",
     "quote": "To do so, we use the AdamW optimizer (Loshchilov & Hutter, 2019) with a weight decay value of 0.1.",
     "location": "Section 5 (Weight decay), txt l.696-698"
    },
    "weight_decay": {
     "value": "0.1",
     "quote": "To do so, we use the AdamW optimizer (Loshchilov & Hutter, 2019) with a weight decay value of 0.1.",
     "location": "Section 5, txt l.696-698"
    },
    "noisy_nets": {
     "value": "removed",
     "quote": "Removing NoisyNets results in large computational and memory savings",
     "location": "Section 4, txt l.605-606"
    },
    "target_network": {
     "value": "EMA target network",
     "quote": "Comparison of BBF and SR-SPR at replay ratios 2 and 8 with and without EMA target networks.",
     "location": "Figure 7 caption, txt l.626-627"
    },
    "environment_steps": {
     "value": "100k (400k frames)",
     "quote": "100k steps (400k frames) at 60 FPS is 111 minutes.",
     "location": "Footnote 2, layout l.311"
    },
    "base_agent": {
     "value": "SR-SPR (Dopamine)",
     "quote": "BBF uses a modified version of the recently introduced SR-SPR agent (D’Oro et al., 2023).",
     "location": "Section 4, txt l.538-539"
    }
   },
   "per_dataset_conditions": {},
   "evaluation_protocol": {
    "seeds": "50",
    "episodes_per_seed": "not stated",
    "checkpoint_selection": "end of training (last)",
