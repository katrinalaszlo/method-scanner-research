{
  "arxiv_id": "2004.13649",
  "title": "Image Augmentation Is All You Need: Regularizing Deep Reinforcement Learning from Pixels",
  "methods": [
    {
      "method_name": "DrQ (Eff. DQN + DrQ)",
      "is_own_method": true,
      "one_paragraph_description": "DrQ (Data-regularized Q) applies image augmentation (random shifts and intensity on Atari) to input observations of a standard model-free RL agent, and additionally regularizes the Q-function by averaging target Q values over K augmented copies of the next state and Q values over M augmented copies of the current state. On Atari 100k the configuration is DrQ [K=1,M=1] applied on top of 'Efficient DQN' (DQN with double Q-learning, 10-step returns, dueling architecture). No auxiliary loss, no pretraining.",
      "conventional_lineage_hint": "model-free RL from pixels with data augmentation ('a simple data augmentation technique that can be applied to standard model-free reinforcement learning algorithms'); applied to DQN for Atari 100k",
