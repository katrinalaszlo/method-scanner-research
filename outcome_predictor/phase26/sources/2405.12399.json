{
 "arxiv_id": "2405.12399",
 "title": "Diffusion for World Modeling: Visual Details Matter in Atari",
 "methods": [
  {
   "method_name": "DIAMOND",
   "is_own_method": true,
   "one_paragraph_description": "Model-based RL agent (DIffusion As a Model Of eNvironment Dreams) whose world model is a diffusion model (EDM formulation, UNet, frame-stacked conditioning on the last 4 frames and actions) that generates the next 64x64 frame with 3 Euler denoising steps; a separate CNN+LSTM reward/termination model predicts rewards and episode ends. The actor-critic (CNN+LSTM) is trained entirely on imagined trajectories of horizon 15 inside the diffusion world model with lambda-returns, then acts in the real environment (epsilon-greedy 0.01 collection).",
   "conventional_lineage_hint": "model-based RL / world models, agents trained entirely within a world model: 'a new best among agents trained entirely within a world model'; 'diffusion for world modeling'",
