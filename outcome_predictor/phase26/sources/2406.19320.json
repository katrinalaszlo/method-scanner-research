{
 "arxiv_id": "2406.19320",
 "title": "Efficient World Models with Context-Aware Tokenization",
 "methods": [
  {
   "method_name": "∆-IRIS",
   "is_own_method": true,
   "one_paragraph_description": "Model-based RL agent (successor to IRIS) that trains a discrete autoencoder encoding each frame into only 4 '∆-tokens' conditioned on the previous frame and action (context-aware tokenization), plus a 3-layer autoregressive transformer over ∆-tokens and I-tokens (continuous frame embeddings) that predicts next tokens, reward and termination. A CNN+LSTM actor-critic (tied weights) is trained purely in imagination (horizon 15, burn-in 5 frames, lambda-returns, discount 0.997) inside the world model and acts epsilon-greedily (0.01) in the environment.",
   "conventional_lineage_hint": "model-based RL agents learning in imagination / world models: 'we consider four model-based RL agents learning in imagination: SimPLe ..., DreamerV3 ..., STORM ..., and IRIS'",
