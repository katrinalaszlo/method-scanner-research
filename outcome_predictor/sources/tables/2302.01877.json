 "title": "AdaptDiffuser: Diffusion Models as Adaptive Self-evolving Planners",
 "methods": [
  {
   "method_name": "AdaptDiffuser",
   "is_own_method": true,
   "one_paragraph_description": "AdaptDiffuser starts from a Diffuser-style trajectory diffusion planner and iteratively self-evolves it: it generates a large number of synthetic trajectories with reward-gradient guidance, filters them with a reward discriminator (a per-dataset return threshold for MuJoCo, Table 7) and dynamics-consistency constraints, adds the surviving trajectories to the training set as synthetic expert data, and fine-tunes the diffusion model (warm-started from a pre-trained Diffuser, with 1/4 the training steps); this is repeated for several phases. At runtime it plans like Diffuser: guided reverse diffusion over a horizon-T trajectory conditioned on the current state, executing the resulting action sequence with reward-gradient guidance.",
   "conventional_lineage_hint": "diffusion-based planning for offline RL: 'Diffusion models have demonstrated their powerful generative capability in many tasks, with great potential to serve as a paradigm for offline reinforcement learning' ; 'an evolutionary planning method with diffusion'",
   "global_conditions": {
